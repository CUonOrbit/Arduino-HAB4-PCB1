# ==========================================
# KiCad Files to Ignore (Cadlab/GitHub Clean)
# ==========================================

# 1. Ignore your specific auto-saves, backups, and lock files
HAB4-PCB1-backups/
#auto_saved_files#
*.lck

# 2. General KiCad auto-saves and backups (just in case names change)
*-backups/
**/-bak/
*_autosave-*
*.bak
*.bck

# 3. Local user-specific settings (Crucial to ignore!)
# These contain your personal screen layout, zoom levels, and local paths
*.kicad_prl
*.kicad_user
fp-info-cache

# 4. Manufacturing outputs (Generate these fresh when needed)
# Keeps the repo clean of temporary fabrication files
Plots/
Gerbers/
*.gbr
*.drl
*.pos
*.rpt

# 5. OS-specific junk
.DS_Store
Thumbs.db